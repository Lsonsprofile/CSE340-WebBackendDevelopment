<%- include('partials/header') %>

<main>

   <h1>
      <%= title %>
   </h1>

   <!-- Edit organization form -->
   <form action="/edit-organization/<%= organization.organization_id %>" method="POST">

      <div class="form-group">

         <label for="name">Organization Name</label>

         <!-- Organization name -->
         <input
            type="text"
            id="name"
            name="name"
            value="<%= organization.name %>"
            required
            maxlength="150">

      </div>

      <div class="form-group">

         <label for="description">Description</label>

         <!-- Organization description -->
         <textarea
            id="description"
            name="description"
            required
            maxlength="500"><%= organization.description %></textarea>

      </div>

      <div class="form-group">

         <label for="contactEmail">Contact Email</label>

         <!-- Contact email -->
         <input
            type="email"
            id="contactEmail"
            name="contactEmail"
            value="<%= organization.contact_email %>"
            required>

      </div>

      <div class="form-group">

         <label for="logoFilename">Logo Filename</label>

         <!-- Logo filename -->
         <input
            type="text"
            id="logoFilename"
            name="logoFilename"
            value="<%= organization.logo_filename %>"
            required
            maxlength="255">

      </div>

      <button type="submit">
         Update Organization
      </button>

   </form>

</main>

<%- include('partials/footer') %>